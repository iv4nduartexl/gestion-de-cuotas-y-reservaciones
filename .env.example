# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose.yml reads the POSTGRES_* values too)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=cuotas_reservas
POSTGRES_PORT=54329
DATABASE_URL=postgres://app:app@localhost:54329/cuotas_reservas

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Public origin of the app (used for links in emails and origin checks)
BETTER_AUTH_URL=http://localhost:3000

# Email
# "console" logs emails to the terminal. Add real transports in lib/email/.
EMAIL_TRANSPORT=console
# Better Auth rate limiting (on in production). Keep "on" outside tests.
AUTH_RATE_LIMIT=on

EMAIL_FROM="Agenda <no-reply@localhost>"
