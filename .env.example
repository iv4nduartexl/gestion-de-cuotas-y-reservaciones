# Copy to .env and adjust. Never commit .env.

# PostgreSQL (docker-compose.yml reads the POSTGRES_* values too)
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=cuotas_reservas
POSTGRES_PORT=54329
DATABASE_URL=postgres://app:app@localhost:54329/cuotas_reservas

# Better Auth
# Generate a secret with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-at-least-32-random-characters
# Public origin of the app (used for links in emails and origin checks)
BETTER_AUTH_URL=http://localhost:3000

# Email
# "console" logs emails to the terminal (development). "smtp" sends them for
# real (production; see docs/deploy.md).
EMAIL_TRANSPORT=console
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASSWORD=
# Sign-in and public booking rate limits. Keep "on" outside tests.
RATE_LIMITS=on

EMAIL_FROM="Agenda <no-reply@localhost>"

# Scheduled jobs (/api/cron/run: cuotas + reminders), every 15 minutes.
# Callers send "Authorization: Bearer <CRON_SECRET>". Leave unset to disable
# the endpoint. Generate with: openssl rand -base64 32. See docs/cron.md.
# CRON_SECRET=
# Where `npm run cron:run` and the docker "cron" profile call the app
# (defaults to BETTER_AUTH_URL / http://host.docker.internal:3000).
# CRON_URL=

# Online payment providers enabled, comma-separated. "manual" (payments
# recorded by hand) is always on. See docs/payment-providers.md.
PAYMENT_PROVIDERS=manual
# Only for development and tests: enables the "fake" provider's webhooks.
# FAKE_PROVIDER_SECRET=

# Developer admin: these accounts (verified email) get /admin, a list of every
# business with "Entrar como dueño" (1-hour impersonation, recorded in the
# business's Actividad). Comma-separated. Leave empty for no admin.
# ADMIN_EMAILS=you@example.com
